    <string name="provider_murena_description">Privacy-focused, deGoogled online workspace from France built on Nextcloud and OnlyOffice, including calendars, tasks, journals, and contacts, with a free tier to get started.</string>
    <string name="provider_tabdigital_description">Managed Nextcloud hosting in the EU with calendars, tasks, journals, contacts, and files. Offers a free account to get started without a credit card.</string>
    <string name="provider_hetzner_description">Managed Nextcloud hosting from Germany with full calendar, tasks, journals, contacts, and file synchronization.</string>
    <string name="provider_woelkli_description">Secure Nextcloud-based cloud storage hosted in Switzerland, including calendars, tasks, journals, and contacts. Includes a free tier.</string>
    <string name="provider_disroot_description">Community-run, donation-funded platform from the Netherlands built on Nextcloud, offering calendars, tasks, journals, and more for free.</string>
    <string name="provider_nextcloud_description">Host your own calendar, contacts, tasks, and notes while maintaining full control over your data.</string>
    <string name="provider_baikal_description">Lightweight open-source CalDAV and CardDAV server designed for self-hosting.</string>
    <string name="provider_radicale_description">Lightweight open-source CalDAV and CardDAV server designed for self-hosting, supporting events, tasks, and journals.</string>
    <string name="provider_mailbox_org_description">Privacy-focused email, calendar, contacts, and task management hosted in Germany with excellent CalDAV support.</string>
    <string name="provider_fastmail_description">Fast and reliable email, calendar, and contact synchronization with excellent standards support.</string>
    <string name="provider_infomaniak_description">Swiss-hosted productivity services with strong privacy protections and excellent value.</string>
    <string name="provider_mailfence_description">Privacy-focused email and collaboration services hosted in Belgium.</string>
    <string name="provider_runbox_description">Norwegian email and collaboration platform focused on privacy and sustainability.</string>
    <string name="provider_migadu_description">Swiss email hosting designed for custom domains and technical users.</string>
    <string name="provider_posteo_description">Privacy-first email, calendar, and contacts provider from Germany.</string>

