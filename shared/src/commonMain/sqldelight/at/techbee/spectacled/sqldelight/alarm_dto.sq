-- One row per VALARM of an entry. icsBlock (the serialized VALARM, unfolded lines joined by '\n')
-- is the source of truth and is parsed back into the domain Alarm, so alarms we can't edit
-- round-trip unchanged. The other columns are derived from it or local-only:
--  - action / triggerAt: for querying upcoming alarms without parsing every block. triggerAt
--    (epoch millis) is computed from the entry's DTSTART/DUE when the entry is saved; NULL if
--    the alarm can't fire.
--  - lastNotifiedAt (epoch millis): when this device last showed a notification for it. Never synced.
--  - snoozedUntil (epoch millis): set when the user snoozed the notification. Never synced. It
--    replaces triggerAt as the time the alarm is due (COALESCE(snoozedUntil, triggerAt)), and
--    snoozing clears lastNotifiedAt so the alarm is due again.
CREATE TABLE AlarmDto (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    icalEntryId INTEGER NOT NULL REFERENCES IcalEntryDto(id) ON DELETE CASCADE,
    uid TEXT,
    action TEXT,
    icsBlock TEXT NOT NULL,
    triggerAt INTEGER,
    lastNotifiedAt INTEGER,
    snoozedUntil INTEGER
);

CREATE INDEX idx_alarm_icalEntryId ON AlarmDto(icalEntryId);
CREATE INDEX idx_alarm_triggerAt ON AlarmDto(triggerAt);

getAlarmsForEntry:
SELECT * FROM AlarmDto WHERE icalEntryId = ? ORDER BY id;

getAlarmsForEntries:
SELECT * FROM AlarmDto WHERE icalEntryId IN ? ORDER BY id;

-- Alarms that should be shown as a notification between fromMillis (incl.) and untilMillis (excl.), earliest first,
-- by the time they are due (the snooze time if snoozed). Only tasks' alarms notify: RFC 5545
-- allows no VALARM in a VJOURNAL, so alarms another client put on a journal or note are kept and
-- synced but stay silent. Entries that are deleted, completed or cancelled are skipped here;
-- whatever needs the domain model (e.g. recurring entries) is filtered by the caller.
getUpcomingAlarms:
SELECT * FROM AlarmDto
WHERE COALESCE(snoozedUntil, triggerAt) >= :fromMillis
  AND COALESCE(snoozedUntil, triggerAt) < :untilMillis
  AND lastNotifiedAt IS NULL
  AND action IN ('DISPLAY', 'AUDIO')
  AND icalEntryId IN (
      SELECT id FROM IcalEntryDto
      WHERE calendarComponent = 'VTODO'
        AND COALESCE(syncState, '') NOT IN ('LOCAL_DELETED', 'REMOTE_DELETED_LOCAL_TRASHBIN', 'CONFLICT_LOCAL_DELETED_SERVER_MODIFIED')
        AND COALESCE(status, '') NOT IN ('COMPLETED', 'CANCELLED')
        AND COALESCE(percentComplete, 0) < 100
  )
ORDER BY COALESCE(snoozedUntil, triggerAt)
LIMIT :maxCount;

insertAlarm:
INSERT INTO AlarmDto (
    icalEntryId,
    uid,
    action,
    icsBlock,
    triggerAt,
    lastNotifiedAt,
    snoozedUntil
) VALUES (?, ?, ?, ?, ?, ?, ?);

-- Alarms whose trigger time still matters: notified ones already went off.
getUnnotifiedAlarms:
SELECT * FROM AlarmDto WHERE lastNotifiedAt IS NULL;

updateTriggerAt:
UPDATE AlarmDto SET triggerAt = :triggerAt WHERE id = :id;

deleteAlarmsForEntry:
DELETE FROM AlarmDto WHERE icalEntryId = ?;

updateLastNotifiedAt:
UPDATE AlarmDto SET lastNotifiedAt = :lastNotifiedAt WHERE id = :id;

-- Carries the local notification state over to a copy of the alarm (e.g. an entry moved to another calendar).
updateLocalState:
UPDATE AlarmDto SET lastNotifiedAt = :lastNotifiedAt, snoozedUntil = :snoozedUntil WHERE id = :id;

-- The alarm is due again at snoozedUntil.
snoozeAlarm:
UPDATE AlarmDto SET snoozedUntil = :snoozedUntil, lastNotifiedAt = NULL WHERE id = :id;

-- Alarms too old to still be shown are written off in one statement instead of one per row.
markAlarmsNotifiedBefore:
UPDATE AlarmDto SET lastNotifiedAt = :lastNotifiedAt WHERE COALESCE(snoozedUntil, triggerAt) < :beforeMillis AND lastNotifiedAt IS NULL;
