# Spectacled CORS proxy — example environment file
#
# Copy this to `.env` and adjust for your deployment, then run with either:
#   docker run --env-file server/.env -p 8088:8080 spectacled-proxy
#   # or reference it from docker-compose via `env_file: server/.env`
#
# These are RUNTIME settings — they are read by the app when the container
# starts, not baked into the image. Never commit a real `.env` (it is gitignored).
# On Fly.io you do NOT use this file; put non-secret values in fly.toml's [env]
# block and secrets via `fly secrets set`.
#
# Every variable below is optional and shown with its built-in default. Unset
# variables fall back to those defaults, which are the secure choice.

# Port the proxy binds. PaaS hosts usually inject this for you.
PORT=8088

# Comma-separated web origins allowed by CORS (the site(s) serving the web app).
# Unset = reflect ANY origin (development only; logged as a warning). Set this in production.
PROXY_ALLOWED_ORIGINS=https://spectacled.techbee.at

# Comma-separated allow-list of CalDAV hostnames the proxy may reach.
# Unset = any host. Strongly recommended for a shared/demo instance.
# PROXY_ALLOWED_TARGET_HOSTS=your-caldav.example

# Reject non-https target URLs. Default true.
PROXY_REQUIRE_HTTPS_TARGET=true

# SSRF guard. Default false blocks targets that resolve to
# loopback/link-local/private/metadata addresses. Only set true for local testing.
PROXY_ALLOW_PRIVATE_TARGETS=false
